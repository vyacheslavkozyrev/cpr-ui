# syntax=docker/dockerfile:1
# ---------------------------------------------------------------
# Dockerfile.ci — runtime only, for CI/CD pipeline use
# Static assets are built outside Docker by the workflow (yarn build)
# and copied in here. No build stage, no Node in the image.
#
# Companion: Dockerfile (full multi-stage) for local development
# ---------------------------------------------------------------

FROM nginxinc/nginx-unprivileged:1.27-alpine-slim

# Upgrade Alpine packages to pick up any security fixes not yet in the base image.
USER root
RUN apk upgrade --no-cache
USER nginx

# Copy Vite build output (dist/) into nginx webroot
COPY --chown=nginx:nginx dist/ /usr/share/nginx/html/

# SPA routing: all unknown paths served as index.html
COPY --chown=nginx:nginx nginx.conf /etc/nginx/conf.d/default.conf

# nginx-unprivileged listens on 8080 by default
EXPOSE 8080

CMD ["nginx", "-g", "daemon off;"]
