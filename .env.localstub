# Local Development with Stub Authentication
# Use this when working with local API (localhost:5000) without Entra External ID
VITE_API_MODE=localapi
VITE_USE_MSW=false

# Development Server Configuration
VITE_PORT=3000

# API Configuration
VITE_API_BASE_URL=http://localhost:5000/api

# Authentication - Stub Mode (generates HMAC tokens for local database users)
VITE_ENABLE_STUB_AUTH=true
VITE_JWT_SIGNING_KEY=test-key
VITE_MOCK_USER_ROLE=employee

# Application Configuration
VITE_APP_NAME=CPR - Continuous Performance Review (Local Stub)
VITE_APP_VERSION=1.0.0
VITE_APP_DESCRIPTION=Career Performance Review System - Local Development with Stub Auth
